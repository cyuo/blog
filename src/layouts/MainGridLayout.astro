---
import BackToTop from "@components/control/BackToTop.astro";
import Footer from "@components/Footer.astro";
import Navbar from "@components/Navbar.astro";
import SideBar from "@components/widget/SideBar.astro";
import type { MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";
import ImageWrapper from "../components/misc/ImageWrapper.astro";
import TOC from "../components/widget/TOC.astro";
import { siteConfig } from "../config";
import { MAIN_PANEL_OVERLAPS_BANNER_HEIGHT } from "../constants/constants";
import { pathsEqual, url } from "../utils/url-utils";
import Layout from "./Layout.astro";

interface Props {
	title?: string;
	banner?: string;
	bannerBasePath?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	headings?: MarkdownHeading[];
}

const {
	title,
	banner,
	bannerBasePath,
	description,
	lang,
	setOGTypeArticle,
	headings = [],
} = Astro.props;

const isHomePage = pathsEqual(Astro.url.pathname, url("/"));
const isPostPage = Astro.url.pathname.includes("/posts/");

const hasBannerLink = !!siteConfig.banner.credit.url;

const showBanner = siteConfig.banner.enable && (isHomePage || isPostPage);

const mainPanelTop = showBanner
	? `calc(var(--banner-height-current) - ${MAIN_PANEL_OVERLAPS_BANNER_HEIGHT}rem)`
	: "calc(4.5rem + 2rem)";
---

<Layout title={title} banner={banner} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle} enableBanner={showBanner}>

<!-- Navbar -->
<slot slot="head" name="head"></slot>
<div id="navbar-wrapper" class="fixed top-0 left-0 right-0 z-50 pointer-events-auto">
    <div class="max-w-[var(--page-width)] px-0 md:px-4 mx-auto">
        <Navbar></Navbar>
    </div>
</div>

<!-- Banner -->
<div
	id="banner-wrapper"
	class={`absolute z-10 w-full overflow-hidden transition duration-700`}
	style={`top: calc(-1 * var(--banner-height-extend));`}
>
	<div id="banner" class="transition-swup-fade w-full h-full opacity-0 scale-105">
		{showBanner && <ImageWrapper
			alt="Banner image of the blog"
			class:list={["object-cover h-full"]}
			src={banner || siteConfig.banner.src}
			position={siteConfig.banner.position}
			basePath={bannerBasePath}
		>
		</ImageWrapper>}

		{isHomePage && (
			<div class="absolute inset-0 flex flex-col items-center justify-center text-center px-4 transition-swup-fade">
				<h1 class="center-text glitch is-glitching Ubuntu-font" data-text={siteConfig.title}>
					{siteConfig.title}
				</h1>
				{siteConfig.subtitle && (
					<div class="mt-3 text-white/85 drop-shadow-[0_4px_12px_rgba(0,0,0,0.45)] text-lg md:text-2xl font-medium">
						{siteConfig.subtitle}
					</div>
				)}
			</div>
		)}
	</div>
</div>

<!-- Main content -->
<div id="main-content-wrapper" class="absolute w-full z-30 pointer-events-none" style={`top: ${mainPanelTop}; transition: top 0.6s ease-out;`}>
    <div class="relative max-w-[var(--page-width)] mx-auto pointer-events-auto">
        <div id="main-grid" class="transition duration-700 w-full left-0 right-0 grid grid-cols-[17.5rem_auto] grid-rows-[auto_1fr_auto] lg:grid-rows-[auto]
    mx-auto gap-4 px-0 md:px-4"
        >
            <div id="post-metadata-container" class="transition-swup-fade absolute bottom-full left-0 right-0 w-full px-0 md:px-4 pb-4 pointer-events-auto">
                <div class="rounded-[var(--radius-large)] overflow-hidden backdrop-blur-2xl bg-[var(--card-bg)] shadow-lg transition">
                    <slot name="before-grid"></slot>
                </div>
            </div>

            {siteConfig.banner.enable && siteConfig.banner.credit.enable && <a
                href={siteConfig.banner.credit.url}
                id="banner-credit"
                target="_blank"
                rel="noopener"
                aria-label="Visit image source"
                data-credit-url={siteConfig.banner.credit.url}
                data-credit-text={siteConfig.banner.credit.text}
                class:list={["group onload-animation transition-swup-fade transition-opacity duration-300 absolute flex justify-center items-center rounded-full " +
                "px-3 right-4 -top-[3.25rem] bg-black/60 hover:bg-black/70 h-9",
                {"hover:pr-9 active:bg-black/80": hasBannerLink},
                {"opacity-0 pointer-events-none": !isHomePage}]}
            >
                <Icon class="text-white/75 text-[1.25rem] mr-1" name="material-symbols:copyright-outline-rounded" ></Icon>
                <div class="text-white/75 text-xs">{siteConfig.banner.credit.text}</div>
                <Icon class:list={["transition absolute text-[oklch(0.75_0.14_var(--hue))] right-4 text-[0.75rem] opacity-0",
                    {"group-hover:opacity-100": hasBannerLink}]}
                      name="fa6-solid:arrow-up-right-from-square">
                </Icon>
            </a>}

            <SideBar class="mb-4 row-start-2 row-end-3 col-span-2 lg:row-start-1 lg:row-end-2 lg:col-span-1 lg:max-w-[17.5rem] onload-animation" headings={headings}></SideBar>

            <main id="swup-container" class="transition-swup-fade col-span-2 lg:col-span-1 overflow-hidden">
                <div id="content-wrapper" class="onload-animation">
                    <slot></slot>
                    <div class="footer col-span-2 onload-animation hidden lg:block">
                        <Footer></Footer>
                    </div>
                </div>
            </main>

            <div class="footer col-span-2 onload-animation block lg:hidden">
                <Footer></Footer>
            </div>
        </div>

        <BackToTop></BackToTop>
    </div>
</div>

<!-- The things that should be under the banner, only the TOC for now -->
<div class="absolute w-full z-0 hidden 2xl:block">
    <div class="relative max-w-[var(--page-width)] mx-auto">
        {siteConfig.toc.enable && <div id="toc-wrapper" class:list={["hidden lg:block transition absolute top-0 -right-[var(--toc-width)] w-[var(--toc-width)] items-center",
            {"toc-hide": siteConfig.banner.enable}]}
        >
            <div id="toc-inner-wrapper" class="fixed top-14 w-[var(--toc-width)] h-[calc(100vh_-_20rem)] overflow-y-scroll overflow-x-hidden hide-scrollbar">
                <div id="toc" class="w-full h-full transition-swup-fade ">
                    <div class="h-8 w-full"></div>
                    <TOC headings={headings}></TOC>
                    <div class="h-8 w-full"></div>
                </div>
            </div>
        </div>}

        {!siteConfig.toc.enable && <div id="toc"></div>}
    </div>
</div>

<script>
function updateBannerCredit() {
    const credit = document.getElementById('banner-credit');
    if (!credit) return;

    const currentPath = window.location.pathname;
    const basePath = import.meta.env.BASE_URL || '/';
    const normalizedCurrent = currentPath.replace(/^\/|\/$/g, '').toLowerCase();
    const normalizedBase = basePath.replace(/^\/|\/$/g, '').toLowerCase();
    const isHomePage = normalizedCurrent === normalizedBase;

    if (isHomePage) {
        credit.classList.remove('opacity-0', 'pointer-events-none');
    } else {
        credit.classList.add('opacity-0', 'pointer-events-none');
    }
}

document.addEventListener('DOMContentLoaded', updateBannerCredit);

if (window.swup) {
    window.swup.hooks.on('page:view', updateBannerCredit);
}
</script>
</Layout>
