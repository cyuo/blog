---
import { readFileSync } from "node:fs";
import { load } from "js-yaml";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";

// Read package.json for application info
const packageJson = await import("../../package.json");

// Get Node.js version
const nodeVersion = process.version;

// Get package manager info
const packageManager = packageJson.packageManager || "unknown";

// Get environment info
const isDev = import.meta.env.DEV;
const mode = import.meta.env.MODE;
const platform = process.platform;
const arch = process.arch;

// Define types for pnpm lock file structure
interface LockFileVersionInfo {
	version?: string;
	[key: string]: unknown;
}

interface LockFileImporter {
	dependencies?: Record<string, LockFileVersionInfo>;
	devDependencies?: Record<string, LockFileVersionInfo>;
	[key: string]: unknown;
}

interface LockFileData {
	importers?: {
		"."?: LockFileImporter;
		[key: string]: LockFileImporter | undefined;
	};
	[key: string]: unknown;
}

// Read pnpm-lock.yaml to get actual installed versions
const lockFileContent = readFileSync("pnpm-lock.yaml", "utf-8");
const lockData = load(lockFileContent) as LockFileData;

// Extract actual versions from lock file
const actualVersions: Record<string, string> = {};
if (lockData?.importers?.["."]?.dependencies) {
	for (const [name, info] of Object.entries(
		lockData.importers["."].dependencies,
	)) {
		if (info?.version) {
			// Extract the base version (before any parentheses)
			const version = info.version.split("(")[0].trim();
			actualVersions[name] = version;
		}
	}
}
if (lockData?.importers?.["."]?.devDependencies) {
	for (const [name, info] of Object.entries(
		lockData.importers["."].devDependencies,
	)) {
		if (info?.version) {
			const version = info.version.split("(")[0].trim();
			actualVersions[name] = version;
		}
	}
}

// Get dependencies with actual versions
const dependencies = packageJson.dependencies || {};
const devDependencies = packageJson.devDependencies || {};

// Create sorted lists with actual versions
const sortedDeps = Object.entries(dependencies)
	.map(
		([name]) => [name, actualVersions[name] || "unknown"] as [string, string],
	)
	.sort(([a], [b]) => a.localeCompare(b));

const sortedDevDeps = Object.entries(devDependencies)
	.map(
		([name]) => [name, actualVersions[name] || "unknown"] as [string, string],
	)
	.sort(([a], [b]) => a.localeCompare(b));
---

<MainGridLayout title={i18n(I18nKey.versionInfo)} description={i18n(I18nKey.versionInfo)}>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full">
            <h1 id="version-info" class="text-3xl font-bold mb-6 text-black/90 dark:text-white/90">
                {i18n(I18nKey.versionInfo)}
                <a href="#version-info" class="anchor">
                    <span class="anchor-icon" data-pagefind-ignore>#</span>
                </a>
            </h1>

            <!-- Application Info -->
            <section class="mb-8">
                <h2 id="application" class="text-2xl font-bold mb-4 text-black/90 dark:text-white/90">
                    {i18n(I18nKey.application)}
                    <a href="#application" class="anchor">
                        <span class="anchor-icon" data-pagefind-ignore>#</span>
                    </a>
                </h2>
                <div class="overflow-x-auto">
                    <table class="w-full border-collapse text-75">
                        <tbody>
                            <tr class="border-b border-black/10 dark:border-white/15">
                                <td class="py-2 px-4 font-medium">{i18n(I18nKey.name)}</td>
                                <td class="py-2 px-4">{packageJson.name}</td>
                            </tr>
                            <tr class="border-b border-black/10 dark:border-white/15">
                                <td class="py-2 px-4 font-medium">{i18n(I18nKey.version)}</td>
                                <td class="py-2 px-4">{packageJson.version}</td>
                            </tr>
                            <tr class="border-b border-black/10 dark:border-white/15">
                                <td class="py-2 px-4 font-medium">{i18n(I18nKey.mode)}</td>
                                <td class="py-2 px-4">{isDev ? i18n(I18nKey.development) : i18n(I18nKey.production)} ({mode})</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- Runtime Environment -->
            <section class="mb-8">
                <h2 id="runtime-environment" class="text-2xl font-bold mb-4 text-black/90 dark:text-white/90">
                    {i18n(I18nKey.runtimeEnvironment)}
                    <a href="#runtime-environment" class="anchor">
                        <span class="anchor-icon" data-pagefind-ignore>#</span>
                    </a>
                </h2>
                <div class="overflow-x-auto">
                    <table class="w-full border-collapse text-75">
                        <tbody>
                            <tr class="border-b border-black/10 dark:border-white/15">
                                <td class="py-2 px-4 font-medium">{i18n(I18nKey.nodejs)}</td>
                                <td class="py-2 px-4">{nodeVersion}</td>
                            </tr>
                            <tr class="border-b border-black/10 dark:border-white/15">
                                <td class="py-2 px-4 font-medium">{i18n(I18nKey.packageManager)}</td>
                                <td class="py-2 px-4">{packageManager}</td>
                            </tr>
                            <tr class="border-b border-black/10 dark:border-white/15">
                                <td class="py-2 px-4 font-medium">{i18n(I18nKey.platform)}</td>
                                <td class="py-2 px-4">{platform}</td>
                            </tr>
                            <tr class="border-b border-black/10 dark:border-white/15">
                                <td class="py-2 px-4 font-medium">{i18n(I18nKey.architecture)}</td>
                                <td class="py-2 px-4">{arch}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- Dependencies -->
            <section class="mb-8">
                <h2 id="dependencies" class="text-2xl font-bold mb-4 text-black/90 dark:text-white/90">
                    {i18n(I18nKey.dependencies)} ({sortedDeps.length})
                    <a href="#dependencies" class="anchor">
                        <span class="anchor-icon" data-pagefind-ignore>#</span>
                    </a>
                </h2>
                <div class="overflow-x-auto">
                    <table class="w-full border-collapse text-sm text-75">
                        <thead>
                            <tr class="border-b-2 border-black/20 dark:border-white/25">
                                <th class="py-2 px-4 text-left font-semibold">{i18n(I18nKey.package)}</th>
                                <th class="py-2 px-4 text-left font-semibold">{i18n(I18nKey.version)}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {sortedDeps.map(([name, version]) => (
                                <tr class="border-b border-black/10 dark:border-white/15">
                                    <td class="py-2 px-4 font-mono text-xs">{name}</td>
                                    <td class="py-2 px-4 font-mono text-xs">{version}</td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- Dev Dependencies -->
            <section class="mb-8">
                <h2 id="dev-dependencies" class="text-2xl font-bold mb-4 text-black/90 dark:text-white/90">
                    {i18n(I18nKey.devDependencies)} ({sortedDevDeps.length})
                    <a href="#dev-dependencies" class="anchor">
                        <span class="anchor-icon" data-pagefind-ignore>#</span>
                    </a>
                </h2>
                <div class="overflow-x-auto">
                    <table class="w-full border-collapse text-sm text-75">
                        <thead>
                            <tr class="border-b-2 border-black/20 dark:border-white/25">
                                <th class="py-2 px-4 text-left font-semibold">{i18n(I18nKey.package)}</th>
                                <th class="py-2 px-4 text-left font-semibold">{i18n(I18nKey.version)}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {sortedDevDeps.map(([name, version]) => (
                                <tr class="border-b border-black/10 dark:border-white/15">
                                    <td class="py-2 px-4 font-mono text-xs">{name}</td>
                                    <td class="py-2 px-4 font-mono text-xs">{version}</td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </div>
</MainGridLayout>

<style>
@reference "../styles/tailwind.css";
    table {
        width: 100%;
    }

    tbody tr:hover {
        background-color: rgba(0, 0, 0, 0.03);
    }

    :global(.dark) tbody tr:hover {
        background-color: rgba(255, 255, 255, 0.05);
    }

    /* Anchor styles matching markdown.css */
    h1, h2 {
        .anchor {
            @apply !transition !-m-0.5 !ml-[0.2ch] !p-0.5 !select-none !opacity-0 !relative !font-medium !text-[var(--primary)];
            text-decoration: underline;
            text-decoration-color: var(--link-underline);
            text-decoration-style: dashed;
            text-decoration-thickness: 1px;
            text-underline-offset: 4px;
            display: inline-block;
            box-decoration-break: clone;
            -webkit-box-decoration-break: clone;

            .anchor-icon {
                @apply !mx-[0.45ch];
            }

            &:hover, &:active {
                text-decoration-color: transparent;
                background: var(--btn-plain-bg-hover);
                border-bottom: 1px dashed var(--link-hover);
                text-decoration: none;
            }
        }

        &:hover {
            .anchor {
                @apply !opacity-100;
            }
        }
    }
</style>
