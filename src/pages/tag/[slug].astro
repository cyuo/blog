---
import ArchivePanel from "@components/ArchivePanel.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import taxonomyMap from "../../assets/meta/taxonomy-map.json";
import { getSortedPostsList } from "../../utils/content-utils";
import { getTagName } from "../../utils/taxonomy";

export async function getStaticPaths() {
	const sortedPostsList = await getSortedPostsList();
	type SortedPost = Awaited<ReturnType<typeof getSortedPostsList>>[number];

	// Get all unique tag slugs
	const tagMap = new Map<string, { slug: string; posts: SortedPost[] }>();
	sortedPostsList.forEach((post) => {
		const tags = post.data.tags || [];

		tags.forEach((tagSlug: string) => {
			if (!tagMap.has(tagSlug)) {
				tagMap.set(tagSlug, {
					slug: tagSlug,
					posts: [],
				});
			}
			const tagItem = tagMap.get(tagSlug);
			if (tagItem) {
				tagItem.posts.push(post);
			}
		});
	});

	return Array.from(tagMap.values()).map((tag) => ({
		params: { slug: tag.slug },
		props: {
			filteredPosts: tag.posts,
			allPosts: sortedPostsList,
		},
	}));
}

const { slug } = Astro.params;
const { filteredPosts } = Astro.props;
const tagName = getTagName(slug as string);
---

<MainGridLayout title={`${i18n(I18nKey.archive)} - #${tagName}`}>
    <ArchivePanel sortedPosts={filteredPosts} tags={[slug]} taxonomyMap={taxonomyMap} client:only="svelte"></ArchivePanel>
</MainGridLayout>
