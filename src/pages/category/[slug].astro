---
import ArchivePanel from "@components/ArchivePanel.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import taxonomyMap from "../../assets/meta/taxonomy-map.json";
import { getSortedPostsList } from "../../utils/content-utils";
import { getCategoryName } from "../../utils/taxonomy";

export async function getStaticPaths() {
	const UNCATEGORIZED_SLUG = "uncategorized";
	const sortedPostsList = await getSortedPostsList();

	// Get all unique category slugs
	const categoryMap = new Map<
		string,
		{ slug: string; posts: typeof sortedPostsList }
	>();
	sortedPostsList.forEach((post) => {
		const categorySlug = post.data.category;
		if (categorySlug) {
			const existingCategory = categoryMap.get(categorySlug);
			if (!existingCategory) {
				categoryMap.set(categorySlug, {
					slug: categorySlug,
					posts: [post],
				});
			} else {
				existingCategory.posts.push(post);
			}
		}
	});

	const uncategorizedPosts = sortedPostsList.filter(
		(post) =>
			!post.data.category ||
			(typeof post.data.category === "string" &&
				post.data.category.trim() === ""),
	);
	if (uncategorizedPosts.length > 0) {
		const uncategorizedCategory = categoryMap.get(UNCATEGORIZED_SLUG);
		if (uncategorizedCategory) {
			uncategorizedCategory.posts.push(...uncategorizedPosts);
		} else {
			categoryMap.set(UNCATEGORIZED_SLUG, {
				slug: UNCATEGORIZED_SLUG,
				posts: uncategorizedPosts,
			});
		}
	}

	return Array.from(categoryMap.values()).map((category) => ({
		params: { slug: category.slug },
		props: {
			filteredPosts: category.posts,
			allPosts: sortedPostsList,
			isUncategorized: category.slug === UNCATEGORIZED_SLUG,
		},
	}));
}

const { slug } = Astro.params;
const { filteredPosts, isUncategorized } = Astro.props;
const categoryName = isUncategorized
	? i18n(I18nKey.uncategorized)
	: getCategoryName(slug as string);
---

<MainGridLayout title={`${i18n(I18nKey.archive)} - ${categoryName}`}>
    <ArchivePanel
            sortedPosts={filteredPosts}
            categories={isUncategorized ? [] : [slug as string]}
            taxonomyMap={taxonomyMap}
            client:only="svelte"
    ></ArchivePanel>
</MainGridLayout>
